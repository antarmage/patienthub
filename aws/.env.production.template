# =============================================================================
# Saivie API — Production Environment Variables Template
#
# DO NOT commit this file with real values.
# In AWS, store all secrets in AWS Secrets Manager and inject via ECS task
# definition (see aws/ecs-task-definition.json "secrets" section).
#
# For local production testing only, copy to .env.production and fill in.
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# ── Database (AWS RDS PostgreSQL) ─────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/DATABASE_NAME?sslmode=require
DATABASE_URL=postgresql://saivie:CHANGE_ME@your-rds-endpoint.rds.amazonaws.com:5432/saivie?sslmode=require

# ── Session ───────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
SESSION_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_64

# ── AWS S3 (file uploads) ─────────────────────────────────────────────────────
# When running on ECS Fargate with an IAM task role, you do NOT set
# AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY — the SDK picks up the role automatically.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=saivie-uploads-prod

# ── WhatsApp Business API (Meta) ──────────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_VERSION=v21.0

# ── Google Service Account (Drive + Sheets) ───────────────────────────────────
GOOGLE_CLIENT_EMAIL=saivie-service@your-project.iam.gserviceaccount.com
# Newlines in private key must be escaped as \n in a single-line string
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# On AWS, this replaces the Replit AI proxy. Use the real Gemini API key.
GEMINI_API_KEY=
# Base URL for Gemini (standard Google AI endpoint)
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# =============================================================================
# Frontend build-time variables (set during CI/CD build step, not at runtime)
# =============================================================================

# Each frontend is built separately with its own BASE_PATH:
#
#   saivie:         BASE_PATH=/            VITE_API_BASE=https://api.saivie.com
#   saivie-desk:    BASE_PATH=/desk/       VITE_API_BASE=https://api.saivie.com
#   saivie-recover: BASE_PATH=/recover/    VITE_API_BASE=https://api.saivie.com
#   saiviegene:     BASE_PATH=/saiviegene/ VITE_API_BASE=https://api.saivie.com
#
# These are injected at build time via GitHub Actions env: block.
# They are NOT secrets — they are embedded into the JS bundle.

# =============================================================================
# GitHub Actions secrets to configure (Settings → Secrets and Variables)
# =============================================================================
#
# Secrets (sensitive):
#   AWS_ACCESS_KEY_ID          — IAM user for CI/CD (ECR push, S3 sync, ECS deploy)
#   AWS_SECRET_ACCESS_KEY      — IAM user secret
#
# Variables (non-sensitive, used in matrix builds):
#   S3_BUCKET_SAIVIE           — e.g. saivie-app-prod
#   S3_BUCKET_DESK             — e.g. saivie-desk-prod
#   S3_BUCKET_RECOVER          — e.g. saivie-recover-prod
#   S3_BUCKET_GENE             — e.g. saivie-gene-prod
#   CF_DIST_SAIVIE             — CloudFront distribution ID for app.saivie.com
#   CF_DIST_DESK               — CloudFront distribution ID for desk.saivie.com
#   CF_DIST_RECOVER            — CloudFront distribution ID for recover.saivie.com
#   CF_DIST_GENE               — CloudFront distribution ID for gene.saivie.com
